{
  "name": "intentra-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "start": "npm run build && node electron/launch.cjs",
    "desktop": "node electron/launch.cjs",
    "test": "vitest run && node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "format": "prettier --write src electron tests",
    "typecheck": "tsc --noEmit",
    "check:format": "prettier --check src electron tests"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.2.0",
    "@fontsource/geist-sans": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "^45.0.0",
    "jsdom": "^27.0.0",
    "playwright": "^1.58.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^4.0.0"
  }
}
