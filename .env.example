# Copy to backend/.env, never to the frontend. Preserve an existing local .env.
# Shell values take precedence. No API key is required.
VOICE_MODE=push_to_talk
DEBUG_RECORDING=false
TTS=false
SCREENSHOTS=true
LOCAL_OCR=false
VOICE_DIAGNOSTICS=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Compatibility names used by the Parakeet worker:
WHISPER_CPU_THREADS=2
WHISPER_NUM_WORKERS=1
WHISPER_TIMEOUT_SECONDS=15
# Set optional INTENTRA_MODEL_DIR and INTENTRA_PYTHON in the launch shell.
# See docs/SETUP.md. Never place secrets in VITE_* variables.
